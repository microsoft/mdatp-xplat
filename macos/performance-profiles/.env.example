# Copy to .env (in this directory or the directory you run demo.py from)
# to set defaults without re-typing flags on every invocation.
# Real environment variables and CLI flags always take precedence over
# values defined here.

# 1) Scenario: vscode | xcode | xcode-simulator | android-studio
# MDE_DEMO_SCENARIO=vscode

# 2) Repo path override (absolute or ~-expanded)
# MDE_DEMO_REPO=~/demo/vscode

# 3) Resume from phase N (0-indexed integer)
# MDE_DEMO_RESUME_FROM=2

# 4) Include npm install in timed build phases (vscode only): true|false
# MDE_DEMO_INCLUDE_INSTALL=false

# 5) Require XMDE Client Analyzer in preflight: true|false
# MDE_DEMO_REQUIRE_CLIENT_ANALYZER=false

# 6) Custom Client Analyzer install/detection directory
# MDE_DEMO_CLIENT_ANALYZER_DIR=~/demo/analyzer/XMDEClientAnalyzerBinary

# 7) Client Analyzer scenario preference: auto | on | off
MDE_DEMO_CLIENT_ANALYZER=auto

# 8) Temporary AV exclusion workflow preference: auto | on | off
MDE_DEMO_AV_EXCLUSIONS=auto

# 9) Require GitHub Copilot CLI in preflight: true|false
# MDE_DEMO_REQUIRE_GHCP_CLI=true

# 10) Hot-event analysis mode (vscode only): prompt | python | ghcp | both
# MDE_DEMO_HOT_EVENTS_ANALYSIS=prompt

# 11) Consent policy for applying/removing profiles: prompt | always | never
# MDE_DEMO_PROFILE_CHANGE_POLICY=prompt
